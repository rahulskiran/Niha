{% doc %}
  @prompt
    create a premium stock alert which show a random nunmber of stock and has a lot of customoization options
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-stock-alert-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.spacing }}px;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    {% if block.settings.show_border %}
      border: {{ block.settings.border_width }}px {{ block.settings.border_style }} {{ block.settings.border_color }};
    {% endif %}
    {% if block.settings.show_shadow %}
      box-shadow: 0 {{ block.settings.shadow_offset_y }}px {{ block.settings.shadow_blur }}px {{ block.settings.shadow_color }};
    {% endif %}
    justify-content: {{ block.settings.alignment }};
    max-width: 100%;
  }

  .ai-stock-alert-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    {% if block.settings.icon_background_enabled %}
      background-color: {{ block.settings.icon_background_color }};
      border-radius: {{ block.settings.icon_border_radius }}px;
      padding: {{ block.settings.icon_padding }}px;
    {% endif %}
  }

  .ai-stock-alert-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    color: {{ block.settings.icon_color }};
  }

  .ai-stock-alert-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.text_spacing }}px;
    flex-grow: 1;
  }

  .ai-stock-alert-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    font-weight: {{ block.settings.text_weight }};
    line-height: {{ block.settings.line_height }};
    margin: 0;
    {% if block.settings.text_transform != 'none' %}
      text-transform: {{ block.settings.text_transform }};
    {% endif %}
  }

  .ai-stock-alert-number-{{ ai_gen_id }} {
    color: {{ block.settings.number_color }};
    font-size: {{ block.settings.number_size }}px;
    font-weight: {{ block.settings.number_weight }};
    {% if block.settings.number_transform != 'none' %}
      text-transform: {{ block.settings.number_transform }};
    {% endif %}
  }

  .ai-stock-alert-subtext-{{ ai_gen_id }} {
    color: {{ block.settings.subtext_color }};
    font-size: {{ block.settings.subtext_size }}px;
    font-weight: {{ block.settings.subtext_weight }};
    line-height: 1.4;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-stock-alert-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_vertical_mobile }}px {{ block.settings.padding_horizontal_mobile }}px;
      gap: {{ block.settings.spacing_mobile }}px;
    }

    .ai-stock-alert-icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size_mobile }}px;
      height: {{ block.settings.icon_size_mobile }}px;
    }

    .ai-stock-alert-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size_mobile }}px;
    }

    .ai-stock-alert-number-{{ ai_gen_id }} {
      font-size: {{ block.settings.number_size_mobile }}px;
    }

    .ai-stock-alert-subtext-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtext_size_mobile }}px;
    }
  }
{% endstyle %}

<stock-alert-{{ ai_gen_id }} class="ai-stock-alert-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.show_icon %}
    <div class="ai-stock-alert-icon-{{ ai_gen_id }}">
      {% if block.settings.icon_type == 'fire' %}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/>
        </svg>
      {% elsif block.settings.icon_type == 'alert' %}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="8" x2="12" y2="12"/>
          <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
      {% elsif block.settings.icon_type == 'clock' %}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <polyline points="12 6 12 12 16 14"/>
        </svg>
      {% elsif block.settings.icon_type == 'box' %}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
          <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
          <line x1="12" y1="22.08" x2="12" y2="12"/>
        </svg>
      {% elsif block.settings.icon_type == 'trending' %}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/>
          <polyline points="17 6 23 6 23 12"/>
        </svg>
      {% elsif block.settings.icon_type == 'star' %}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
        </svg>
      {% endif %}
    </div>
  {% endif %}

  <div class="ai-stock-alert-content-{{ ai_gen_id }}">
    <p class="ai-stock-alert-text-{{ ai_gen_id }}">
      {% if block.settings.text_before != blank %}
        {{ block.settings.text_before }}
      {% endif %}
      <span class="ai-stock-alert-number-{{ ai_gen_id }}" data-stock-number></span>
      {% if block.settings.text_after != blank %}
        {{ block.settings.text_after }}
      {% endif %}
    </p>
    {% if block.settings.subtext != blank %}
      <p class="ai-stock-alert-subtext-{{ ai_gen_id }}">{{ block.settings.subtext }}</p>
    {% endif %}
  </div>
</stock-alert-{{ ai_gen_id }}>

<script>
  (function() {
    class StockAlert{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.stockNumberElement = this.querySelector('[data-stock-number]');
        this.minStock = {{ block.settings.min_stock }};
        this.maxStock = {{ block.settings.max_stock }};
        this.updateInterval = {{ block.settings.update_interval }} * 1000;
        this.enableAutoUpdate = {{ block.settings.enable_auto_update }};
      }

      connectedCallback() {
        this.generateRandomStock();
        
        if (this.enableAutoUpdate && this.updateInterval > 0) {
          this.startAutoUpdate();
        }
      }

      generateRandomStock() {
        const randomStock = Math.floor(Math.random() * (this.maxStock - this.minStock + 1)) + this.minStock;
        this.stockNumberElement.textContent = randomStock;
      }

      startAutoUpdate() {
        setInterval(() => {
          this.generateRandomStock();
        }, this.updateInterval);
      }

      disconnectedCallback() {
        if (this.intervalId) {
          clearInterval(this.intervalId);
        }
      }
    }

    customElements.define('stock-alert-{{ ai_gen_id }}', StockAlert{{ ai_gen_id }});
  })();
</script>

