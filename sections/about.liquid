{%- liquid
  assign settings = section.settings
-%}

{% style %}
  {{ settings.display_font | font_face: font_display: 'swap' }}
{% endstyle %}

{%- capture about_style -%}
  --about-bg: {{ settings.color_background }};
  --about-ink: {{ settings.color_ink }};
  --about-muted: {{ settings.color_muted }};
  --about-accent: {{ settings.color_accent }};
  --about-max-width: {{ settings.max_width }}px;
  --about-padding-inline: {{ settings.padding_inline }}px;
  --about-padding-block-start: {{ settings.padding_block_start }}px;
  --about-padding-block-end: {{ settings.padding_block_end }}px;
  --about-display-font-family: {{ settings.display_font.family }}, {{ settings.display_font.fallback_families }};
  --about-body-font-family: var(--font-{{ settings.body_font }}--family);
{%- endcapture -%}

<div class="about-page" style="{{ about_style }}" {{ section.shopify_attributes }}>
  <div class="about">
    {%- if settings.kicker != blank -%}
      <p class="about__kicker">{{ settings.kicker }}</p>
    {%- endif -%}

    {%- if settings.quote != blank -%}
      <p class="about__quote">
        <span class="about__quote-mark" aria-hidden="true">&#8220;</span>{{ settings.quote }}
      </p>
      <span class="about__rule"></span>
    {%- endif -%}

    {%- if settings.body != blank -%}
      <div class="about__body">{{ settings.body }}</div>
    {%- endif -%}

    {%- if settings.closing != blank -%}
      <span class="about__rule about__rule--closing"></span>
      <p class="about__closing">{{ settings.closing }}</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .about-page {
    padding-inline: var(--about-padding-inline, 40px);
    padding-block: var(--about-padding-block-start, 96px) var(--about-padding-block-end, 96px);
    background: var(--about-bg, #ffffff);
  }

  .about {
    max-width: var(--about-max-width, 640px);
    margin-inline: auto;
    text-align: center;
  }

  .about__kicker {
    margin: 0 0 20px;
    font-family: var(--about-body-font-family);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--about-accent, #1f3d2c);
  }

  .about__quote {
    position: relative;
    max-width: 780px;
    margin: 0 auto;
    font-family: var(--about-display-font-family);
    font-weight: 400;
    font-style: italic;
    font-size: 34px;
    line-height: 1.3;
    color: var(--about-ink, #201c19);
    text-wrap: balance;
  }

  .about__quote-mark {
    display: block;
    font-family: var(--about-display-font-family);
    font-style: normal;
    font-size: 64px;
    line-height: 1;
    color: var(--about-accent, #1f3d2c);
    opacity: 0.35;
    margin-bottom: -8px;
  }

  .about__rule {
    display: block;
    width: 44px;
    height: 1px;
    margin: 36px auto;
    background: var(--about-accent, #1f3d2c);
    opacity: 0.4;
  }

  .about__rule--closing {
    margin-top: 48px;
    margin-bottom: 32px;
  }

  .about__body {
    display: flex;
    flex-direction: column;
    gap: 24px;
    font-family: var(--about-body-font-family);
    font-size: 16px;
    line-height: 1.75;
    color: var(--about-muted, #57534a);
  }

  .about__body p {
    margin: 0;
  }

  .about__closing {
    margin: 0;
    font-family: var(--about-display-font-family);
    font-style: italic;
    font-weight: 400;
    font-size: 22px;
    letter-spacing: 0.01em;
    color: var(--about-accent, #1f3d2c);
  }

  @media screen and (max-width: 599px) {
    .about-page {
      padding-inline: 24px;
    }

    .about__quote {
      font-size: 25px;
    }

    .about__quote-mark {
      font-size: 48px;
    }

    .about__closing {
      font-size: 19px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "About",
  "tag": "section",
  "class": "about-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "About"
    },
    {
      "type": "text",
      "id": "quote",
      "label": "Pull quote",
      "default": "Made for the woman who knows who she is."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body copy"
    },
    {
      "type": "text",
      "id": "closing",
      "label": "Closing line",
      "default": "This is Niha. Welcome in."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 400,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 640
    },
    {
      "type": "range",
      "id": "padding_inline",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_block_start",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_block_end",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "font_picker",
      "id": "display_font",
      "label": "Display font",
      "info": "Used for the pull quote and closing line.",
      "default": "garamond_i4"
    },
    {
      "type": "select",
      "id": "body_font",
      "label": "Body font",
      "options": [
        { "value": "body", "label": "Body" },
        { "value": "subheading", "label": "Subheading" },
        { "value": "heading", "label": "Heading" },
        { "value": "accent", "label": "Accent" }
      ],
      "default": "body"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "color_ink",
      "label": "Text",
      "default": "#201C19"
    },
    {
      "type": "color",
      "id": "color_muted",
      "label": "Body text",
      "default": "#57534A"
    },
    {
      "type": "color",
      "id": "color_accent",
      "label": "Accent",
      "default": "#1F3D2C"
    }
  ],
  "presets": [
    {
      "name": "About"
    }
  ]
}
{% endschema %}
