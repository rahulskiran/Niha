{% comment %}
  Announcement Bar Section
  - Includes settings for text, font size (desktop & mobile), scrolling behavior, and speed.
  - UPDATED: Now uses a "Seamless Loop" technique by duplicating text to remove gaps.
{% endcomment %}

{%- style -%}
  .announcement-bar-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.text_size }}px;
    padding: 10px 0;
    position: relative;
    overflow: hidden;
    line-height: 1.5;
    z-index: 50;
  }

  .announcement-bar-{{ section.id }} a {
    color: {{ section.settings.text_color }};
    text-decoration: underline;
  }

  /* Static State (When scrolling is off) */
  .announcement-bar__content-static {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    padding: 0 20px;
    box-sizing: border-box;
    text-align: center;
  }

  /* Static State with multiple messages: stack them and crossfade between them */
  .announcement-bar__rotator {
    display: grid;
    grid: [stack] auto / [stack] auto;
    width: 100%;
    padding: 0 20px;
    box-sizing: border-box;
  }

  .announcement-bar__rotator-item {
    grid-area: stack;
    text-align: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.5s ease-in-out, visibility 0.5s ease-in-out;
  }

  .announcement-bar__rotator-item.is-active {
    opacity: 1;
    visibility: visible;
  }

  /* Scrolling State Wrapper */
  .announcement-bar__marquee-window {
    width: 100%;
    overflow: hidden;
    white-space: nowrap;
    display: flex;
    align-items: center;
  }

  .announcement-bar__marquee-track {
    display: flex;
    flex-wrap: nowrap;
    width: fit-content;
    will-change: transform;
    animation: marquee-{{ section.id }} {{ section.settings.scroll_speed }}s linear infinite;
  }

  /* The sets of repeated text */
  .announcement-bar__item-set {
    display: flex;
    flex-wrap: nowrap;
    padding: 0;
    margin: 0;
  }

  .announcement-bar__message {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    /* Spacing the messages with a trailing margin rather than padding on both sides keeps the
       gap identical between two messages and across the seam where set 2 follows set 1. */
    margin-inline-end: {{ section.settings.message_gap }}px;
  }

  /* Force rich text paragraphs to be inline */
  .announcement-bar__message p, 
  .announcement-bar__content-static p {
    margin: 0;
    padding: 0;
    display: inline-block;
  }

  .announcement-bar__message br,
  .announcement-bar__content-static br {
    display: none;
  }

  /* Pause on hover */
  .announcement-bar-{{ section.id }}:hover .announcement-bar__marquee-track {
    animation-play-state: paused;
  }

  @keyframes marquee-{{ section.id }} {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      /* Move exactly 50% left. Because we have 2 identical sets, 
         when Set 1 moves out, Set 2 is in the exact position Set 1 started. 
         This creates the invisible loop. */
      transform: translate3d(-50%, 0, 0);
    }
  }

  /* --- MOBILE TEXT SIZE OVERRIDE --- */
  @media screen and (max-width: 749px) {
    .announcement-bar-{{ section.id }} {
      font-size: {{ section.settings.mobile_text_size }}px;
    }

    .announcement-bar__message {
      margin-inline-end: {{ section.settings.mobile_message_gap }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  # Messages come from "Announcement" blocks. When none have been added, fall back
  # to the section-level text setting so existing sections keep working unchanged.
  assign messages = section.blocks | where: 'type', 'message'
  assign message_count = messages.size

  if message_count == 0
    assign legacy_text = section.settings.text
    if legacy_text == blank
      assign legacy_text = '<p>Welcome to our store</p>'
    endif
  endif

  # Spread the repeated marquee track evenly across messages instead of always
  # repeating a single message 15 times, capped so a long list doesn't shrink
  # the repeat count below what's needed to fill wide screens.
  assign marquee_reps = 15 | divided_by: message_count | at_least: 3
-%}

{%- if section.settings.show_announcement -%}
  <div class="announcement-bar-{{ section.id }}" role="region" aria-label="Announcement">

    {%- if section.settings.enable_scroll -%}
      <!-- SCROLLING MODE: Seamless Infinite Loop -->
      <div class="announcement-bar__marquee-window">
        <div class="announcement-bar__marquee-track">

          {%- comment -%}
            We generate TWO sets of repeated text.
            The animation slides the whole track by 50% (the width of one set).
          {%- endcomment -%}

          {%- for set in (1..2) -%}
            <div class="announcement-bar__item-set">
              {%- if message_count > 0 -%}
                {%- comment -%} Repeat the full message list to ensure it fills any screen width {%- endcomment -%}
                {%- for rep in (1..marquee_reps) -%}
                  {%- for block in messages -%}
                    <div class="announcement-bar__message" {{ block.shopify_attributes }}>
                      {{ block.settings.text }}
                    </div>
                  {%- endfor -%}
                {%- endfor -%}
              {%- else -%}
                {%- comment -%} Repeat the message 15 times to ensure it fills any screen width {%- endcomment -%}
                {%- for i in (1..15) -%}
                  <div class="announcement-bar__message">
                    {{ legacy_text }}
                  </div>
                {%- endfor -%}
              {%- endif -%}
            </div>
          {%- endfor -%}

        </div>
      </div>

    {%- elsif message_count > 1 -%}
      <!-- STATIC MODE: Rotating through multiple announcements -->
      <div
        class="announcement-bar__rotator"
        data-interval="{{ section.settings.static_rotate_speed }}"
      >
        {%- for block in messages -%}
          <div
            class="announcement-bar__rotator-item{% if forloop.first %} is-active{% endif %}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.text }}
          </div>
        {%- endfor -%}
      </div>
      <script>
        (function () {
          var root = document.currentScript.previousElementSibling;
          if (!root) return;
          var items = root.querySelectorAll('.announcement-bar__rotator-item');
          if (items.length <= 1) return;
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

          var interval = (parseFloat(root.dataset.interval) || 4) * 1000;
          var index = 0;

          setInterval(function () {
            items[index].classList.remove('is-active');
            index = (index + 1) % items.length;
            items[index].classList.add('is-active');
          }, interval);
        })();
      </script>

    {%- else -%}
      <!-- STATIC MODE: Centered Single Text -->
      <div class="announcement-bar__content-static">
        {%- if message_count == 1 -%}
          {{ messages.first.settings.text }}
        {%- else -%}
          {{ legacy_text }}
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement",
      "default": true
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "info": "Only used when no Announcement blocks are added below. Add blocks to show multiple announcements.",
      "default": "<p>Welcome to our store</p>"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 12,
      "max": 36,
      "step": 1,
      "unit": "px",
      "label": "Desktop Text size",
      "default": 14
    },
    {
      "type": "range",
      "id": "mobile_text_size",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Mobile Text size",
      "default": 12
    },
    {
      "type": "range",
      "id": "message_gap",
      "min": 20,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Space between messages",
      "default": 80
    },
    {
      "type": "range",
      "id": "mobile_message_gap",
      "min": 15,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Mobile space between messages",
      "default": 45
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Scrolling Options"
    },
    {
      "type": "checkbox",
      "id": "enable_scroll",
      "label": "Enable scrolling text",
      "default": false
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "min": 10,
      "max": 100,
      "step": 2,
      "unit": "s",
      "label": "Scroll speed (duration)",
      "info": "Because the text is repeated many times, you may need a higher number (slower speed) than before.",
      "default": 40
    },
    {
      "type": "range",
      "id": "static_rotate_speed",
      "min": 2,
      "max": 15,
      "step": 1,
      "unit": "s",
      "label": "Rotation speed",
      "info": "Only used with scrolling text off and more than one Announcement block. Time each message stays visible before switching to the next.",
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Announcement",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Welcome to our store</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Announcement Bar",
      "blocks": [
        {
          "type": "message",
          "settings": {
            "text": "<p>Welcome to our store</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}