{%- liquid
  assign settings = section.settings

  # wa.me only accepts digits - strip anything a merchant might reasonably type
  # (+, spaces, dashes, parentheses) so the link still works regardless of format.
  assign phone_digits = settings.phone_number
    | remove: '+'
    | remove: ' '
    | remove: '-'
    | remove: '('
    | remove: ')'
-%}

{%- if phone_digits != blank -%}
  <a
    href="https://wa.me/{{ phone_digits }}{% if settings.message != blank %}?text={{ settings.message | url_encode }}{% endif %}"
    class="whatsapp-button whatsapp-button--{{ settings.position }}{% if settings.show_on_mobile == false %} whatsapp-button--hide-mobile{% endif %}{% if settings.show_on_desktop == false %} whatsapp-button--hide-desktop{% endif %}"
    style="
      --whatsapp-size: {{ settings.size }}px;
      --whatsapp-bg: {{ settings.background_color }};
      --whatsapp-icon-color: {{ settings.icon_color }};
      --whatsapp-offset: {{ settings.edge_offset }}px;
    "
    target="_blank"
    rel="noopener"
    aria-label="{{ 'accessibility.chat_on_whatsapp' | t | default: 'Chat on WhatsApp' }}"
    {{ section.shopify_attributes }}
  >
    <svg viewBox="0 0 32 32" fill="none" aria-hidden="true" focusable="false">
      <path
        fill="currentColor"
        d="M16.004 3C9.377 3 4 8.373 4 15c0 2.294.638 4.44 1.746 6.27L4 29l7.933-1.703A11.94 11.94 0 0 0 16.004 27C22.63 27 28 21.627 28 15S22.63 3 16.004 3Zm6.965 16.845c-.294.828-1.457 1.516-2.386 1.71-.635.132-1.464.238-4.255-.914-3.573-1.474-5.873-5.077-6.052-5.313-.172-.236-1.453-1.933-1.453-3.687 0-1.755.907-2.617 1.229-2.976.323-.36.706-.45.94-.45.235 0 .47.002.674.012.216.01.507-.082.793.606.294.706.998 2.439 1.084 2.617.087.177.145.386.029.622-.116.236-.174.383-.343.59-.172.207-.36.462-.514.62-.172.177-.352.368-.152.723.201.354.892 1.472 1.916 2.384 1.316 1.174 2.427 1.538 2.782 1.715.354.177.561.148.769-.089.207-.236.882-1.03 1.117-1.384.236-.354.472-.295.792-.177.32.118 2.03.958 2.377 1.133.348.177.58.265.665.413.087.148.087.855-.207 1.683Z"
      />
    </svg>
  </a>
{%- endif -%}

{% stylesheet %}
  .whatsapp-button {
    position: fixed;
    bottom: var(--whatsapp-offset, 24px);
    z-index: var(--layer-overlay, 40);
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--whatsapp-size, 56px);
    height: var(--whatsapp-size, 56px);
    background: var(--whatsapp-bg, #25d366);
    color: var(--whatsapp-icon-color, #ffffff);
    border-radius: 50%;
    box-shadow: 0 3px 10px rgb(0 0 0 / 0.25);
    text-decoration: none;
    transition: transform 0.2s ease;
  }

  .whatsapp-button:hover {
    transform: scale(1.06);
    text-decoration: none;
  }

  .whatsapp-button svg {
    width: 58%;
    height: 58%;
    display: block;
  }

  .whatsapp-button--bottom-right {
    right: var(--whatsapp-offset, 24px);
  }

  .whatsapp-button--bottom-left {
    left: var(--whatsapp-offset, 24px);
  }

  @media screen and (max-width: 749px) {
    .whatsapp-button--hide-mobile {
      display: none;
    }
  }

  @media screen and (min-width: 750px) {
    .whatsapp-button--hide-desktop {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "WhatsApp icon",
  "tag": "section",
  "class": "whatsapp-icon-section",
  "settings": [
    {
      "type": "text",
      "id": "phone_number",
      "label": "WhatsApp number",
      "info": "Include the country code, e.g. 919876543210. The button stays hidden until this is set.",
      "placeholder": "919876543210"
    },
    {
      "type": "text",
      "id": "message",
      "label": "Pre-filled message",
      "default": "Hi! I have a question about"
    },
    {
      "type": "header",
      "content": "Position"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Corner",
      "options": [
        { "value": "bottom-right", "label": "Bottom right" },
        { "value": "bottom-left", "label": "Bottom left" }
      ],
      "default": "bottom-right"
    },
    {
      "type": "range",
      "id": "edge_offset",
      "label": "Edge spacing",
      "min": 8,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "size",
      "label": "Button size",
      "min": 40,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "label": "Show on mobile",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_desktop",
      "label": "Show on desktop",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#25D366"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "WhatsApp icon"
    }
  ]
}
{% endschema %}
