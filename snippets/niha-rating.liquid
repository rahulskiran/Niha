{%- doc -%}
  Renders a compact star rating beneath a product card title, read from the
  product's custom.product_rating / custom.product_rating_count metafields (filled in
  by hand in the admin or by a reviews app). Products without a rating show empty
  stars and "No reviews yet"; the theme editor shows sample stars instead.

  @param {object} product - The product object
{%- enddoc -%}

{%- liquid
  assign rating = product.metafields.custom.product_rating.value.rating
  assign scale_max = product.metafields.custom.product_rating.value.scale_max | default: 5
  assign rating_count = product.metafields.custom.product_rating_count.value | default: 0

  # Theme editor only: sample stars (mostly 5, some 4.5) so the design can be reviewed before real
  # ratings exist. Never rendered on the storefront.
  if rating == blank and request.design_mode
    assign sample_step = product.id | modulo: 3
    assign rating = 5.0
    if sample_step == 0
      assign rating = 4.5
    endif
    assign rating_count = product.id | modulo: 90 | plus: 12
  endif
-%}

{%- if rating == blank -%}
  <div class="niha-rating niha-rating--empty">
    <span class="niha-rating__stars" style="--niha-rating-fill: 0%;" aria-hidden="true"></span>
    <span class="niha-rating__value">No reviews yet</span>
  </div>
{%- else -%}
  {%- assign fill_percent = rating | times: 100.0 | divided_by: scale_max -%}
  <div
    class="niha-rating"
    role="img"
    aria-label="Rated {{ rating | round: 1 }} out of {{ scale_max }}{% if rating_count > 0 %}, {{ rating_count }} reviews{% endif %}"
  >
    <span
      class="niha-rating__stars"
      style="--niha-rating-fill: {{ fill_percent }}%;"
      aria-hidden="true"
    ></span>
    <span class="niha-rating__value" aria-hidden="true">
      {{- rating | round: 1 -}}
      {%- if rating_count > 0 %} ({{ rating_count }}){% endif -%}
    </span>
  </div>
{%- endif -%}

{% stylesheet %}
  .niha-rating {
    --niha-rating-gold: #c59d3f;

    grid-column: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
    margin: 6px 0 8px;
    font-size: clamp(0.6875rem, 0.65rem + 0.2vw, 0.8125rem);
    line-height: 1;
    color: var(--niha-muted, #8b8577);
  }

  /* Two layers of the same five stars: a faint gold track, and a filled copy clipped to the rating */
  .niha-rating__stars {
    position: relative;
    display: inline-block;
    font-size: clamp(0.8125rem, 0.75rem + 0.3vw, 1rem);
    letter-spacing: 2px;
    line-height: 1;
    white-space: nowrap;
  }

  .niha-rating__stars::before {
    content: '★★★★★';
    color: var(--niha-rating-gold);
    opacity: 0.25;
  }

  .niha-rating__stars::after {
    content: '★★★★★';
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--niha-rating-fill, 0%);
    overflow: hidden;
    white-space: nowrap;
    color: var(--niha-rating-gold);
  }
{% endstylesheet %}
