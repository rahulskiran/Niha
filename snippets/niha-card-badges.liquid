{%- doc -%}
  Renders the overlay badges on an editorial collection card.

  @param {object} product - The product object
  @param {string} [badge] - Top-left badge text, e.g. "Limited Edition"
  @param {string} [label] - Bottom-left soft badge text, e.g. "Core Collection"
  @param {boolean} [preorder] - Whether the product is sold as a pre-order
  @param {string} [ships] - Ships-by date shown beside the pre-order chip
{%- enddoc -%}

{%- liquid
  assign show_bottom = false
  if product.available == false or preorder or label != blank
    assign show_bottom = true
  endif

  # Discount tag is derived from the product's own compare-at price - it only
  # shows when there's a genuine discount, and reflects the real percent off.
  assign variant = product.selected_or_first_available_variant
  assign on_sale = false
  if variant.compare_at_price > variant.price
    assign on_sale = true
    assign percent_off = variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round
  endif

  assign show_top = false
  if badge != blank or on_sale
    assign show_top = true
  endif
-%}

{%- if show_top -%}
  <div class="niha-badges niha-badges--top">
    {%- if on_sale -%}
      <span class="niha-badge niha-badge--sale">{{ percent_off }}% off</span>
    {%- endif -%}
    {%- if badge != blank -%}
      <span class="niha-badge niha-badge--plain">{{ badge }}</span>
    {%- endif -%}
  </div>
{%- endif -%}

{%- if show_bottom -%}
  <div class="niha-badges niha-badges--bottom">
    {%- if product.available == false -%}
      <span class="niha-badge niha-badge--solid">{{ 'content.product_badge_sold_out' | t }}</span>
    {%- elsif preorder -%}
      <span class="niha-badge niha-badge--solid">Pre-order</span>
      {%- if ships != blank -%}
        <span class="niha-badge niha-badge--plain">Ships {{ ships }}</span>
      {%- endif -%}
    {%- endif -%}
    {%- if label != blank -%}
      <span class="niha-badge niha-badge--soft">{{ label }}</span>
    {%- endif -%}
  </div>
{%- endif -%}
